NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

OPENAI_API_KEY=sk-proj-
# Single model knob for every LLM call (memory extraction + prompt rebuilds).
# Codex/dev runs default to gpt-5.4-mini; Claude Code hook batches default to
# anthropic/claude-haiku-4-5 when this is unset.
# LLM_MODEL=gpt-5.4-mini
# Claude via LiteLLM can use a logged-in Claude Code subscription without
# ANTHROPIC_API_KEY. Leave Anthropic key/base-url vars unset so MKG can read a
# fresh OAuth token from the platform credential store at call time. Uncomment to
# force Claude for every harness, not only Claude Code hook batches.
# LLM_MODEL=anthropic/claude-haiku-4-5

# Optional
GCP_PROJECT_ID=llm-experiments-387609
GCP_BILLING_PROJECT_ID=
BIGQUERY_DATASET_ID=acme_corp
BIGQUERY_MCP_URL=https://bigquery.googleapis.com/mcp

# Optional
DIFFBOT_TOKEN=
