{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-sync python hooks/log_event.py --client codex"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-sync python hooks/log_event.py --client codex"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-sync python hooks/log_event.py --client codex"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-sync python hooks/inject_system_prompt.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-sync python hooks/log_event.py --client codex"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-sync python hooks/log_event.py --client codex"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-sync python hooks/log_event.py --client codex"
          }
        ]
      }
    ]
  }
}
