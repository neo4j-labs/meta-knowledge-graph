{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=\"$(git rev-parse --show-toplevel)\"; MKG_HOOK_ROOT=\"$ROOT\" uv run --script \"$ROOT/hooks/inject_system_prompt.py\""
          },
          {
            "type": "command",
            "command": "ROOT=\"$(git rev-parse --show-toplevel)\"; MKG_HOOK_ROOT=\"$ROOT\" uv run --script \"$ROOT/hooks/inject_project_context.py\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=\"$(git rev-parse --show-toplevel)\"; MKG_HOOK_ROOT=\"$ROOT\" uv run --script \"$ROOT/hooks/log_event.py\" --client codex"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=\"$(git rev-parse --show-toplevel)\"; MKG_HOOK_ROOT=\"$ROOT\" uv run --script \"$ROOT/hooks/log_event.py\" --client codex"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=\"$(git rev-parse --show-toplevel)\"; MKG_HOOK_ROOT=\"$ROOT\" uv run --script \"$ROOT/hooks/log_event.py\" --client codex"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=\"$(git rev-parse --show-toplevel)\"; MKG_HOOK_ROOT=\"$ROOT\" uv run --script \"$ROOT/hooks/log_event.py\" --client codex"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=\"$(git rev-parse --show-toplevel)\"; MKG_HOOK_ROOT=\"$ROOT\" uv run --script \"$ROOT/hooks/log_event.py\" --client codex"
          }
        ]
      },
      {
        "matcher": ".*(enhance_entity|search_news)$",
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=\"$(git rev-parse --show-toplevel)\"; MKG_HOOK_ROOT=\"$ROOT\" uv run --script \"$ROOT/hooks/ingest_diffbot.py\""
          }
        ]
      },
      {
        "matcher": ".*(bigquery_execute_query|neo4j_read_cypher)$",
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=\"$(git rev-parse --show-toplevel)\"; MKG_HOOK_ROOT=\"$ROOT\" uv run --script \"$ROOT/hooks/capture_query_failures.py\""
          },
          {
            "type": "command",
            "command": "ROOT=\"$(git rev-parse --show-toplevel)\"; MKG_HOOK_ROOT=\"$ROOT\" uv run --script \"$ROOT/hooks/inject_query_error_context.py\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=\"$(git rev-parse --show-toplevel)\"; MKG_HOOK_ROOT=\"$ROOT\" uv run --script \"$ROOT/hooks/log_event.py\" --client codex"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=\"$(git rev-parse --show-toplevel)\"; MKG_HOOK_ROOT=\"$ROOT\" uv run --script \"$ROOT/hooks/log_event.py\" --client codex"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=\"$(git rev-parse --show-toplevel)\"; MKG_HOOK_ROOT=\"$ROOT\" uv run --script \"$ROOT/hooks/inject_project_context.py\""
          },
          {
            "type": "command",
            "command": "ROOT=\"$(git rev-parse --show-toplevel)\"; MKG_HOOK_ROOT=\"$ROOT\" uv run --script \"$ROOT/hooks/log_event.py\" --client codex"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=\"$(git rev-parse --show-toplevel)\"; MKG_HOOK_ROOT=\"$ROOT\" uv run --script \"$ROOT/hooks/log_event.py\" --client codex"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=\"$(git rev-parse --show-toplevel)\"; MKG_HOOK_ROOT=\"$ROOT\" uv run --script \"$ROOT/hooks/log_event.py\" --client codex"
          },
          {
            "type": "command",
            "command": "ROOT=\"$(git rev-parse --show-toplevel)\"; MKG_HOOK_ROOT=\"$ROOT\" uv run --script \"$ROOT/hooks/process_project.py\" --mode turn --background"
          },
          {
            "type": "command",
            "command": "ROOT=\"$(git rev-parse --show-toplevel)\"; MKG_HOOK_ROOT=\"$ROOT\" uv run --script \"$ROOT/hooks/consolidate_system_prompt.py\" --background"
          },
          {
            "type": "command",
            "command": "ROOT=\"$(git rev-parse --show-toplevel)\"; MKG_HOOK_ROOT=\"$ROOT\" uv run --script \"$ROOT/hooks/consolidate_query_errors.py\" --background"
          }
        ]
      }
    ]
  }
}
